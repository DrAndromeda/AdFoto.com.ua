---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/ru/`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>AdFoto — рекламное агентство в Киеве</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`${Astro.site}ru/`} />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body><a href={target}>AdFoto → /ru/</a></body>
</html>
